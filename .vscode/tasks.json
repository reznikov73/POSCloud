{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Клиент: сборка",
      "type": "shell",
      "command": "wails",
      "args": ["build", "-s", "-skipbindings", "-webview2", "browser"],
      "options": { "cwd": "${workspaceFolder}/poscloud-client" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Сервер: сборка",
      "type": "shell",
      "command": "wails",
      "args": ["build", "-s", "-skipbindings", "-webview2", "browser"],
      "options": { "cwd": "${workspaceFolder}/poscloud-server" },
      "problemMatcher": []
    },
    {
      "label": "Тесты: клиент и сервер",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-Command",
        "Push-Location '${workspaceFolder}/poscloud-client'; go test ./...; $c=$LASTEXITCODE; Pop-Location; Push-Location '${workspaceFolder}/poscloud-server'; go test ./...; $s=$LASTEXITCODE; Pop-Location; exit ($c -bor $s)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Клиент: запуск (dev)",
      "type": "shell",
      "command": "wails",
      "args": ["dev"],
      "options": { "cwd": "${workspaceFolder}/poscloud-client" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Сервер: запуск (dev)",
      "type": "shell",
      "command": "wails",
      "args": ["dev"],
      "options": { "cwd": "${workspaceFolder}/poscloud-server" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Установщик: сборка (приложения + установщик)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File",
        "${workspaceFolder}/installer/build.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Установщик: пересборка (без приложений)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File",
        "${workspaceFolder}/installer/build.ps1",
        "-SkipApps"
      ],
      "problemMatcher": []
    }
  ]
}
