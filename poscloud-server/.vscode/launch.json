{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Отладка (Wails)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags desktop,production,debug,devtools",
      "showLog": true
    },
    {
      "name": "Отладка с параметрами",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags desktop,production,debug,devtools",
      "args": ["-port", "8090"],
      "showLog": true
    }
  ]
}
